# Copying this file alone is not enough: npm run setup generates unique tokens.
# Do not commit .env or real token values.
PORT=8788
CODEX_REMOTE_TOKEN=
CODEX_HOOK_TOKEN=
MOBILE_PRESENCE_TTL_MS=7000
# Optional absolute path to the native Codex executable (codex.exe on Windows).
CODEX_BIN=
# Optional local event storage directory. Keep it private and out of Git.
CODEX_REMOTE_DATA_DIR=data

# Resumable approvals/questions: 24 hours maximum by default.
CODEX_APPROVAL_TIMEOUT_MS=86400000
# Suspend activity animation after 120 seconds without a confirmed task event.
CODEX_TASK_STALE_MS=120000
# Optional Codex profile directory; no personal path is bundled.
CODEX_HOME=
